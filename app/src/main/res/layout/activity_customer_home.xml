<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink"
    android:padding="20dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TechFix"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.TechFix.Display"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/browseServicesBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Browse Services"
        style="@style/Widget.TechFix.Button.Primary"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/myRequestsBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Requests"
        style="@style/Widget.TechFix.Button.Ghost"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/viewBranchesBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Our Branches"
        style="@style/Widget.TechFix.Button.Ghost"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/profileBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Profile"
        style="@style/Widget.TechFix.Button.Ghost"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/logoutBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        style="@style/Widget.TechFix.Button.Ghost" />

</LinearLayout>
